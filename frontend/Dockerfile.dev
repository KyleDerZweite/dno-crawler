FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dependencies
RUN corepack enable && pnpm install --frozen-lockfile

# Expose Vite dev server port
EXPOSE 5173

# Run development server
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]
